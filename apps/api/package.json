{
  "name": "@ecommerce/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-dashboard-assets.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node --require ../../node_modules/.pnpm/dotenv*/node_modules/dotenv/config.js ../../dist/apps/api/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config test/jest.unit.config.ts",
    "test:integration": "jest --config test/jest.integration.config.ts",
    "test:e2e": "jest --config test/jest.e2e.config.ts",
    "openapi:generate": "tsx src/scripts/generate-metadata.ts && tsc -p tsconfig.build.json && tsx ../../dist/apps/api/src/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@ecommerce/domain-shared": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^9.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "11.1.23",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.77.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "joi": "^18.2.1",
    "mariadb": "^3.5.2",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.1.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.23",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
