NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_PUBLIC_URL=http://localhost:3000
ADMIN_ALLOWED_ORIGINS=
STORE_ALLOWED_ORIGINS=http://localhost:3001

# Docker Compose service credentials (used by docker-compose.yml).
# Override these in your local .env file when needed.
MYSQL_ROOT_PASSWORD=root
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
# REDIS_PASSWORD is optional; leave empty for no auth in development.
# Set a value here to enable requirepass in the Redis container.
REDIS_PASSWORD=

# DATABASE_URL and REDIS_URL default to localhost ONLY in development/test.
# In staging and production they are REQUIRED and will fail-fast if missing.
DATABASE_URL=mysql://root:root@localhost:3306/ecommerce
# Direct mode requires no Redis or worker and is suitable for serverless/Vercel.
# Queue mode uses Redis + apps/worker for higher-throughput installations.
EXECUTION_MODE=direct
REDIS_URL=redis://localhost:6379
# Deprecated compatibility switch; retained for legacy tooling only and ignored by the API.
QUEUE_ENABLED=false
QUEUE_PREFIX=ecommerce
MAINTENANCE_SECRET=change-this-to-a-strong-random-value-in-production
# Vercel Cron automatically sends this value in Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=change-this-to-the-same-strong-random-value-on-vercel
MAINTENANCE_BATCH_SIZE=25
DASHBOARD_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# DEV_SEED_ADMIN_EMAIL / DEV_SEED_ADMIN_PASSWORD default ONLY in dev/test.
# In production/staging these MUST be set explicitly, and seed will refuse to run
# unless SEED_ALLOW_PRODUCTION=true (break-glass flag).
DEV_SEED_ADMIN_EMAIL=admin@example.com
DEV_SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ALLOW_PRODUCTION=false

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=ecommerce-public
S3_BUCKET_PRIVATE=ecommerce-private
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_PUBLIC_BASE_URL=http://localhost:9000/ecommerce-public
REPORT_STORAGE_MODE=local

PAYMENT_PROVIDER=cod
PAYMENT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_API_KEY=

# Worker-only credentials required in production when PUSH delivery is enabled.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

LOG_LEVEL=info
OPENAPI_ENABLED=true
SENTRY_DSN=
